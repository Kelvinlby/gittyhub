[Desktop Entry]
Type=Application
Name=GittyHub
GenericName=Git Client
Comment=Git client with deep GitHub integration
Exec=gittyhub %F
Icon=io.github.Kelvinlby.GittyHub
Terminal=false
Categories=Development;RevisionControl;GTK;
Keywords=git;github;version;control;pull;request;
StartupNotify=true
Actions=new-window;
DBusActivatable=false

[Desktop Action new-window]
Name=New Window
Exec=gittyhub --new-window
